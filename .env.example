# Local development: copy this file to .env and fill in values.
# Never commit .env to git.

DISCORD_TOKEN=        # Bot token from Discord Developer Portal
ANTHROPIC_API_KEY=    # Anthropic API key (for LLM calls)
OPENAI_API_KEY=       # OpenAI API key (for DALL-E avatar generation)
OWNER_ID=             # Discord user ID of the bot's owner (integer)
                      # Right-click username in Discord > Copy User ID. 
                      #Requires Developer Mode enabled.
CHANNEL_ID=           # Discord channel ID (integer) where the bot should speak and send proactive messages.
